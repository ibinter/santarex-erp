# ============================================================
# SANTAREX ERP — Variables d'environnement PRODUCTION
# Copier en .env.prod sur le serveur et adapter les valeurs
# ============================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=santarex_db
POSTGRES_USER=santarex
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_db

# Backend NestJS
BACKEND_PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://santarex:CHANGE_ME_mot_de_passe_db@postgres:5432/santarex_db

# JWT (générer: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48_autre
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://santarex.ibigsoft.com/api/v1
FRONTEND_URL=https://santarex.ibigsoft.com
