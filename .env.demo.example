# ══════════════════════════════════════════════════════════════════════════════
#  SANTAREX ERP — Variables de la DÉMONSTRATION PUBLIQUE (cahier IBIG v1.1, §4)
#
#  Copier ce fichier en « .env.demo » à la racine, puis renseigner les secrets.
#      cp .env.demo.example .env.demo
#
#  Utilisé par docker-compose.demo.yml (projet Docker « santarex-demo »).
#  NE JAMAIS réutiliser les secrets de production ici : la démo est isolée.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Mode démonstration ───────────────────────────────────────────────────────
# Active DemoModeGuard côté backend : exports, superadmin, mutations de tenants
# et parcours de paiement renvoient 403 « Action désactivée en démonstration
# publique. ». Indispensable pour une démo publique sûre.
DEMO_MODE=true

# Active l'UX démo côté frontend (bandeau, désactivation d'actions sensibles).
NEXT_PUBLIC_DEMO_MODE=true

# URL publique de la démo (sous-domaine servi par le reverse-proxy de
# l'orchestrateur → port hôte 3100 du frontend-demo).
NEXT_PUBLIC_DEMO_URL=https://demo.santarex.ibigsoft.com

# URL de l'API publique de la démo (→ port hôte 3101 du backend-demo).
NEXT_PUBLIC_DEMO_API_URL=https://demo.santarex.ibigsoft.com/api/v1

# ─── Environnement ────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Base de données de démo (isolée — volume postgres_demo_data) ─────────────
DB_HOST=postgres-demo
DB_PORT=5432
DB_NAME=santarex_demo
DB_USER=santarex
# Secret DÉDIÉ à la démo (différent de la prod). À générer.
DB_PASSWORD=change_me_demo_db_password

# ─── Redis de démo ────────────────────────────────────────────────────────────
REDIS_HOST=redis-demo
REDIS_PORT=6379

# ─── Secrets applicatifs (dédiés démo) ────────────────────────────────────────
# Générer des valeurs propres à la démo (openssl rand -hex 32).
JWT_SECRET=change_me_demo_jwt_secret
JWT_EXPIRATION=1d

# ══════════════════════════════════════════════════════════════════════════════
#  RESET NOCTURNE (à installer par l'orchestrateur — cron 02:00, heure du VPS)
#
#  Le script demo-reset purge les données transactionnelles et réinjecte un jeu
#  100 % FICTIF. Il refuse de tourner si DEMO_MODE != true (garde anti-prod).
#
#  Exemple de ligne crontab sur le VPS (chemin du repo à adapter) :
#    0 2 * * *  cd /opt/santarex && docker compose -p santarex-demo \
#      -f docker-compose.demo.yml exec -T backend-demo \
#      node dist/database/demo-reset.js >> /var/log/santarex-demo-reset.log 2>&1
# ══════════════════════════════════════════════════════════════════════════════
